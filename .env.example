#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Environment: development, testing, production
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Base URL for the application
# For Railway: This will be your generated domain
# Example: https://bookku-production.up.railway.app/
app.baseURL = 'http://localhost:8080/'

# If you have index.php in your URL (e.g., http://example.com/index.php/controller)
# set this to 'index.php'. If not, leave it empty.
app.indexPage = ''

# Default locale
app.defaultLocale = 'en'

# Supported locales
app.supportedLocales = ['en']

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Railway auto-injects these variables when MySQL is connected
# You don't need to set these manually for Railway deployment

# database.default.hostname = localhost
# database.default.database = bookku
# database.default.username = root
# database.default.password = 
# database.default.DBDriver = MySQLi
# database.default.port = 3306

# For Railway, these environment variables are automatically set:
# - MYSQLHOST
# - MYSQLPORT
# - MYSQLDATABASE
# - MYSQLUSER
# - MYSQLPASSWORD

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

# Encryption key
# Generate with: php spark key:generate
# encryption.key = 

# Session cookie name
# session.cookieName = 'ci_session'

# Session save path
# session.savePath = WRITEPATH . 'session'

# Session driver
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# Session match IP
# session.matchIP = false

# CSRF Protection
# security.csrfProtection = 'session'
# security.tokenRandomize = true
# security.tokenName = 'csrf_token_name'
# security.headerName = 'X-CSRF-TOKEN'
# security.cookieName = 'csrf_cookie_name'
# security.expires = 7200

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

# Log threshold (0=Disable, 1=Error, 2=Debug, 3=Info, 4=Warning, 5=Notice, 6=Critical, 7=Alert, 8=Emergency, 9=All)
# logger.threshold = 4

#--------------------------------------------------------------------
# RAILWAY SPECIFIC SETTINGS
#--------------------------------------------------------------------

# These are automatically provided by Railway
# Do not set these manually - they are injected at runtime

# RAILWAY_ENVIRONMENT = production
# RAILWAY_SERVICE_NAME = bookku-app
# RAILWAY_DEPLOYMENT_ID = 
# RAILWAY_PROJECT_ID = 
# PORT = 80
